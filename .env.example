# RentEase Backend Environment Configuration Template

# Set DEBUG=False in production
DEBUG=False
DJANGO_SECRET_KEY=generate-a-secure-random-key-here

# Hosts allowed to connect to Django
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Supabase PostgreSQL Database Settings
# (You can use individual DB_* variables or a single DATABASE_URL)
DB_NAME=postgres
DB_USER=postgres.[your-supabase-project-id]
DB_PASSWORD=[your-supabase-db-password]
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432

# Or connection string:
# DATABASE_URL=postgresql://postgres:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# CORS & CSRF (Comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://*.onrender.com

# Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=homrent1@gmail.com
EMAIL_HOST_PASSWORD=replace-with-google-app-password
DEFAULT_FROM_EMAIL=RentEase Billing <homrent1@gmail.com>
